#!/bin/sh
# Tier 2 of docs/plans/PLAN-CI-CD.md: the full suite, on the machine that has
# the data. Tier 1 runs in CI without a database, which means 99 tests skip
# there; this is where they actually execute.
#
# Install:  ln -sf ../../observatory/ci/pre-push .git/hooks/pre-push
#
# Bypassable with `git push --no-verify`, deliberately: the gate that must not
# be bypassable is Tier 1, and that one runs on GitHub where a push cannot
# argue with it.
#
# Quick by default since 2026-10-11 (the user's call, to speed up deploys): a
# push runs the guards and the registry check, a few seconds. The full data
# suite and the browser checks took ~3 minutes before every push; they run
# with PLOVER_FULL_PREPUSH=1 git push, and the done gate still runs the
# browser checks for any page a Claude session changes.
set -e
cd "$(git rev-parse --show-toplevel)/observatory"

PY=./.venv/bin/python
[ -x "$PY" ] || PY=python

echo "pre-push: guards"
"$PY" ci/guards.py >/dev/null || { "$PY" ci/guards.py; exit 1; }

echo "pre-push: registry"
"$PY" -m app.registry --check >/dev/null || { "$PY" -m app.registry --check; exit 1; }

if [ "${PLOVER_FULL_PREPUSH:-}" != "1" ]; then
    echo "pre-push: quick checks passed (PLOVER_FULL_PREPUSH=1 git push runs the full data suite and browser checks)"
    exit 0
fi

echo "pre-push: suite (full data)"
"$PY" ci/suite.py --mode full

# Use the site like a reader before it ships: type every search box's own
# examples into a hidden browser, and click a write button ten times to check
# it sends once. Needs the data and Chrome, which only this machine has.
echo "pre-push: reader checks (search examples, one click one request)"
"$PY" ci/search_examples.py
