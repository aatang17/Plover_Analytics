# Credentials for /api/v1/{dataset}/ask. Copy to `.env` and fill in — `.env`
# is gitignored. Everything except the ask box works without this file.
#
# ASK_ENABLED defaults to off. Set it to true only when you want the ask box
# to appear; a provider key alone is not enough.
# ASK_ENABLED=true
#
# Set ONE provider key. DeepSeek is checked first when both are present.
# DeepSeek's API matches OpenAI's request/response shape, so the same client
# library serves both.

DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Optional overrides. Defaults: deepseek-chat / gpt-4o-mini for the provider
# above. LLM_BASE_URL also lets you point at any other OpenAI-compatible
# endpoint (local vLLM, Groq, OpenRouter) while still using OPENAI_API_KEY.
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# MCP endpoint (POST /mcp) — lets external AI clients call the data tools.
# On by default (it serves the same numbers as the public API and spends no
# money); set to 0 to turn it off.
# MCP_ENABLED=1
#
# Which tool surface /mcp advertises: v1 (the original per-dataset tools), v2
# (the generic tools over the dataset registry: list_datasets, describe_dataset,
# search, get_company, get_series, screen, plus list_cohorts and
# compare_cohort), or both. Default both, so existing
# connectors keep their tool names while new ones see the generic surface.
# Flip to v2 once nothing depends on the old names.
# MCP_TOOLSET=both

# Absolute base for the `cite` URLs in tool responses. Defaults to the
# production site so links handed to an external AI client resolve for its
# readers. Point it elsewhere if the site moves to a custom domain.
# SITE_BASE_URL=https://web-production-c9178.up.railway.app

# Dataset manifests (app/registry.py). A manifest that fails validation is
# normally quarantined — dropped from the catalog and reported on
# /api/v1/catalog/health — so a typo in one card can never keep the site from
# booting. Set this on a staging box to make such a fault refuse to start.
# MANIFEST_STRICT=0

# Peer-group cohorts (app/cohorts.py). Index membership — the Nikkei 225 — is
# the index publisher's copyrighted work and may not be redistributed, so it is
# refused unless this is explicitly truthy: off by default, like ASK_ENABLED.
# With it unset the cohort is absent from the catalogue, from a company's
# cohort list and from the assistant tools, and asking for it answers 400.
# The JPX classification (market segment, 33/17 industry, TOPIX scale band) is
# published for reuse and is always available. Set this only on a deployment
# entitled to show index membership to whoever can reach it.
# INTERNAL_COHORTS=1

# Admin console (/admin.html) password. Unset = the whole admin surface is
# disabled (every /admin/api endpoint answers 503). There is no default.
# ADMIN_PASSWORD=

# e-Stat application ID — free, from https://www.e-stat.go.jp/mypage/view/api.
# Needed only by the population-jp-history ingest, which reads the e-Stat JSON
# API. Every other dataset uses keyless file downloads and works without it.
# ESTAT_APP_ID=

# Databento futures downloader (tools/databento_download.py). Add your key
# yourself to the private, gitignored .env file. Never put it in chat.
# The downloader defaults to a free cost estimate and asks before paid data.
# DATABENTO_API_KEY=

# --- Daily refresh and monitoring -------------------------------------------
#
# start.sh ingests, serves, and re-ingests when the server ends; app/refresh.py
# ends it once a day. Times are UTC — Japan has no daylight saving, so the
# 09:00 default is 18:00 JST all year, after the MoF posts the yield curve.
# REFRESH_AT=09:00
#
# Kill switch for the daily refresh and the health watch together.
# REFRESH_ENABLED=1
#
# How old data/ingest_heartbeat.json may get before /catalog/health reports the
# refresh as broken. The per-dataset staleness limits (7 to 950 days) are far
# too loose to catch a stopped pipeline; this is the tight signal.
# REFRESH_MAX_AGE_HOURS=26
#
# Slack-shaped webhook ({"text": ...}). Unset means log-only. At most one
# message every six hours per distinct fault.
# ALERT_WEBHOOK_URL=
#
# Where faults are emailed, comma-separated. Needs RESEND_API_KEY and
# RESEND_FROM below as well — an address on its own delivers nothing, which
# /api/v1/catalog/health reports as alerts_deliverable: false.
#
# SET ONE OF THESE. With neither a webhook nor a mailbox the watch below still
# runs every fifteen minutes and still finds everything, and writes it to a log
# nobody reads. That is not a hypothetical: it is why the whole pipeline could
# stop landing data on 14 September 2026 and go six days unnoticed.
# ALERT_EMAIL_TO=
#
# Telegram — the simplest channel: no domain, no mail provider. Create a bot
# with @BotFather (gives the token), send the bot any message, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates. Both are needed.
# Check it end to end with:  python -m app.refresh test-alert
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# How long a dataset may go without the refresh REACHING it before that is a
# fault, in hours (default 26 — the refresh is daily, plus slack). This asks
# about the pipeline, not the source: a monthly dataset with no new month is
# healthy, a dataset the refresh has stopped visiting is not.
# REFRESH_CHECK_MAX_AGE_HOURS=
#
# REFRESH_SUPERVISED is set by start.sh and must not be set by hand: it is what
# arms the daily shutdown, and only start.sh will restart the process.

# EDGAR capture (equity/edgar_capture.py — the internal US comparison archive).
# The SEC refuses any client that does not declare itself: the User-Agent must
# be "Company Name contact@domain" with a real, reachable address. Required by
# that job only; nothing in the web app reads it.
# EDGAR_USER_AGENT=Asia Economics Observations you@yourdomain

# US shelf (SEC Financial Statement Data Sets -> data/sec.duckdb). Optional:
# SEC_QUARTERS=4          quarters loaded at boot (start.sh); backfill.py deepens
# BACKFILL_SEC_QUARTERS=12 quarters to hold in all after boot (0 = leave as is)
# SEC_DB_PATH=            override the file location

# ---- Accounts (email sign-in) --------------------------------------------
# Off unless ACCOUNTS_ENABLED is truthy: without it the /api/v1/account/…
# routes are not mounted at all and the sign-in page says accounts are not
# open yet. An account stores the companies a reader follows; nothing on the
# platform is gated behind one.
ACCOUNTS_ENABLED=
# Invite list, comma-separated. While set, only these addresses can get a
# sign-in link and the public header shows no "Sign in". Empty = open.
ACCOUNTS_ALLOWED_EMAILS=
# Delivery is Resend's HTTP API. Without a key the sign-in link is written to
# the server log instead of emailed, which is how the flow is tested locally.
RESEND_API_KEY=
# The verified sender, e.g. "Plover Analytics <signin@yourdomain.com>".
RESEND_FROM=
# Where emailed links point. Defaults to the address the request arrived on,
# which is wrong behind a proxy — set it in production.
PUBLIC_BASE_URL=
# Laptop only: also return the sign-in link in the API response, so the flow
# can be completed without a mailbox. Never set this in production.
ACCOUNTS_DEV_LINKS=

# IndexNow (app/indexnow.py): after an ingest publishes a release, the pages
# it changed are reported to Bing and the engines sharing its index. Any
# 8-128 letters and digits you choose; the same string is served at
# /indexnow-key.txt as proof. Unset = nothing is sent.
# INDEXNOW_KEY=

# ---- Investment Assistant (app/assistant/) ---------------------------------
# The desk of specialists at /assistant.html. Off unless BOTH this and
# ACCOUNTS_ENABLED are truthy: there is no desk without a signed-in person.
# Specialists run on the customer's own model key, never ours; ASK_ENABLED
# stays off and is unrelated.
ASSISTANT_ENABLED=
# A long random string. Seals each desk's model key and Slack webhook before
# they are stored (app/assistant/keychain.py). Without it a desk can be
# browsed but no key can be stored and no run can start. Changing it makes
# every stored key unreadable; desks then paste theirs again.
ASSISTANT_SECRET=
# Hosts a desk may register as an MCP server despite the address checks in
# app/assistant/mcp_client.py (https-only, public addresses only). Comma
# separated, for local development against a server on this machine. Never set
# this in production: it is what keeps a stored server from reaching the
# container's own network.
# ASSISTANT_MCP_ALLOW_HOSTS=localhost,127.0.0.1
# Google Workspace on the desk's Drive page (read-only Google Drive). From a
# Google Cloud OAuth client of type "Web application", with the Drive API
# enabled and this redirect URI registered:
#   <PUBLIC_BASE_URL>/api/v1/assistant/google/callback
# The scope is drive.readonly, which Google classes as "restricted": until the
# app passes Google's verification, only accounts added as test users on the
# consent screen can connect (up to 100). Unset = the page says Google is not
# set up; uploads to My drive still work.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only if the redirect URI cannot be derived from PUBLIC_BASE_URL.
# GOOGLE_OAUTH_REDIRECT_URI=
